  "measure": "count",
  "result": "failures",
  "execution": "independent",
  "cases": [
    {
      "name": "standing-observations-journal",
      "program": "runtime",
      "args": [
        "--experimental-strip-types",
        "--test",
        "--test-name-pattern",
        "public standing includes attest evidence in observations via journal",
        "test/standing-result-cli.test.ts"
      ],
      "cwd": ".",
      "inputs": [
        "samples/standing/yes.json",
        "samples/standing/no.json",
        "docs/contracts/standing.bound",
        "test/standing-result-cli.test.ts"
      ],
      "timeoutMs": 15000,
      "maxBytes": 262144,
      "exit": 0,
      "matches": [
        {
          "stream": "stdout",
          "pattern": "STANDING observations journal · all classes · collisions retained · exact withdrawals · replay identical · forged excluded"
