{
  "scope": "cli/exit/closed",
  "measure": "cli-exit-closed",
  "result": "status",
  "cases": [
    {
      "program": "runtime",
      "args": [
        "vectors/process/product-closure-case.mjs",
        "dist/cli/verb.js",
        "closed"
      ],
      "cwd": ".",
      "timeoutMs": 25000,
      "maxBytes": 1048576,
      "exit": 0,
      "matches": [
        {
          "stream": "stdout",
          "pattern": "^PASS\\s+closed \u00b7 1 places",
          "flags": "m"
        },
        {
          "stream": "stderr",
          "pattern": "^RECEIPTS [0-9]+ read \u00b7 0 opened",
          "flags": "m"
        }
      ],
      "inputs": [
        "vectors/process/product-closure-case.mjs",
        "dist/cli/verb.js"
      ]
    }
  ],
  "execution": "independent"
}
