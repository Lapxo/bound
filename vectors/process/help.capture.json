{
  "scope": "capture/help",
  "measure": "text",
  "result": "stderr",
  "cases": [
    {
      "program": "runtime",
      "args": [
        "vectors/process/cli-case.mjs",
        "dist/cli/verb.js",
        "usage"
      ],
      "cwd": ".",
      "timeoutMs": 20000,
      "maxBytes": 1048576,
      "exit": 2,
      "matches": [
        {
          "stream": "stderr",
          "pattern": "verbs fold land sign"
        }
      ],
      "inputs": [
        "vectors/process/cli-case.mjs",
        "dist/cli/verb.js"
      ]
    }
  ],
  "execution": "independent"
}
