{
  "scope": "nothing-deleted",
  "measure": "count",
  "result": "failures",
  "cases": [
    {
      "program": "runtime",
      "args": [
        "vectors/process/source-tests.mjs",
        "test/owned-history.test.ts"
      ],
      "cwd": ".",
      "timeoutMs": 70000,
      "maxBytes": 4194304,
      "exit": 0,
      "matches": [
        {
          "stream": "stdout",
          "pattern": "# fail 0(?:\\n|$)"
        },
        {
          "stream": "stdout",
          "pattern": "# pass [1-9][0-9]*(?:\\n|$)"
        }
      ],
      "inputs": [
        "vectors/process/source-tests.mjs",
        "src/cli/verb.ts",
        "TARGET.bound",
        "package.json",
        "test/owned-history.test.ts"
      ]
    }
  ],
  "execution": "independent"
}
