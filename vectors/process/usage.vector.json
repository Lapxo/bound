{
  "scope": "cli/exit/usage",
  "measure": "cli-exit-usage",
  "result": "status",
  "cases": [
    {
      "program": "runtime",
      "args": [
        "vectors/process/cli-case.mjs",
        "dist/cli/verb.js",
        "usage"
      ],
      "cwd": ".",
      "timeoutMs": 20000,
      "maxBytes": 1048576,
      "exit": 2,
      "matches": [
        {
          "stream": "stderr",
          "pattern": "verbs fold land sign"
        }
      ],
      "inputs": [
        "vectors/process/cli-case.mjs",
        "dist/cli/verb.js"
      ]
    }
  ]
}
