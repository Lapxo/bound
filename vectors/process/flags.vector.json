{
  "scope": "cli/flags",
  "measure": "cli-flags",
  "result": "matches",
  "selector": {
    "stream": "stderr",
    "pattern": "--[a-z-]+"
  },
  "cases": [
    {
      "program": "runtime",
      "args": [
        "vectors/process/cli-case.mjs",
        "dist/cli/verb.js",
        "usage"
      ],
      "cwd": ".",
      "timeoutMs": 20000,
      "maxBytes": 1048576,
      "exit": 2,
      "matches": [
        {
          "stream": "stderr",
          "pattern": "flags --as --check --key --key-file --signer --place"
        }
      ],
      "inputs": [
        "vectors/process/cli-case.mjs",
        "dist/cli/verb.js"
      ]
    }
  ],
  "execution": "independent"
}
