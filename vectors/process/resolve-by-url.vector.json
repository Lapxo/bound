{
  "scope": "resolve-by-url",
  "measure": "count",
  "result": "failures",
  "cases": [
    {
      "program": "runtime",
      "args": [
        "vectors/process/source-tests.mjs",
        "--test-name-pattern=declared source closure is verified once",
        "test/source-content.test.ts"
      ],
      "cwd": "bound",
      "timeoutMs": 70000,
      "maxBytes": 4194304,
      "exit": 0,
      "matches": [
        {
          "stream": "stdout",
          "pattern": "# fail 0(?:\\n|$)"
        },
        {
          "stream": "stdout",
          "pattern": "# pass [1-9][0-9]*(?:\\n|$)"
        }
      ],
      "inputs": [
        "bound/vectors/process/source-tests.mjs",
        "bound/src/cli/verb.ts",
        "bound/TARGET.bound",
        "bound/package.json",
        "bound/test/source-content.test.ts"
      ]
    }
  ]
}
