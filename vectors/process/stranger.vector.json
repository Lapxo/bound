{
  "scope": "the-stranger",
  "measure": "count",
  "result": "failures",
  "cases": [
    {
      "program": "runtime",
      "args": [
        "vectors/process/product-closure-case.mjs",
        "dist/cli/verb.js",
        "stranger"
      ],
      "cwd": ".",
      "timeoutMs": 20000,
      "maxBytes": 1048576,
      "exit": 0,
      "matches": [
        {
          "stream": "stdout",
          "pattern": "^RECEIPTS 0 read \u00b7 1 opened$",
          "flags": "m"
        },
        {
          "stream": "stdout",
          "pattern": "^NEEDS    README\\.md$",
          "flags": "m"
        },
        {
          "stream": "stdout",
          "pattern": "^OPEN     uses/world/$",
          "flags": "m"
        },
        {
          "stream": "stdout",
          "pattern": "^RENDER   README\\.md$",
          "flags": "m"
        }
      ],
      "inputs": [
        "vectors/process/product-closure-case.mjs",
        "dist/cli/verb.js"
      ]
    }
  ],
  "execution": "independent"
}
