{
  "format": "neutral-conformance-fixture/1",
  "contract": "signer-coverage-diagnostics",
  "purpose": "acceptance data, not a wire form or another evaluator",
  "domains": [
    "archive-records",
    "water-quality"
  ],
  "initial": {
    "place": "logical-place",
    "epoch": "1",
    "authority": "receiver-declared"
  },
  "policy": {
    "encoding": "UTF-8",
    "lineEnding": "LF",
    "scopeOrdering": "unsigned-UTF8-bytes",
    "runtimeClock": "receiver-explicit",
    "runtimePaths": "adapter-owned; not comparison data"
  },
  "cases": [
    {
      "id": "covered",
      "operation": "signing-request",
      "input": {
        "keyId": "actor",
        "coverage": [
          "records/**"
        ],
        "scopes": [
          "records/one"
        ]
      },
      "expected": {
        "kind": "fact",
        "status": "zero",
        "reason": null,
        "forbiddenEffects": [
          "authority-from-carrier",
          "cross-place-write",
          "secret-disclosure"
        ]
      }
    },
    {
      "id": "uncovered",
      "operation": "signing-request",
      "input": {
        "keyId": "actor",
        "coverage": [
          "records/**"
        ],
        "scopes": [
          "other/z",
          "records/one",
          "other/a"
        ]
      },
      "expected": {
        "kind": "refuse",
        "status": "nonzero",
        "reason": "uncovered-scope",
        "forbiddenEffects": [
          "authority-from-carrier",
          "cross-place-write",
          "secret-disclosure",
          "signature-acquisition",
          "act-admission",
          "accepted-content"
        ],
        "publicCatalogRecord": true,
        "keyId": "actor",
        "firstUncoveredScope": "other/a",
        "signerCalls": 0
      }
    },
    {
      "id": "permuted",
      "operation": "signing-request",
      "input": {
        "keyId": "actor",
        "coverage": [
          "records/**"
        ],
        "scopes": [
          "other/a",
          "other/z",
          "records/one"
        ]
      },
      "expected": {
        "kind": "refuse",
        "status": "nonzero",
        "reason": "uncovered-scope",
        "forbiddenEffects": [
          "authority-from-carrier",
          "cross-place-write",
          "secret-disclosure",
          "signature-acquisition",
          "act-admission",
          "accepted-content"
        ],
        "publicCatalogRecord": true,
        "keyId": "actor",
        "firstUncoveredScope": "other/a",
        "signerCalls": 0
      }
    },
    {
      "id": "unbound",
      "operation": "signing-request",
      "input": {
        "keyId": "unbound",
        "coverage": [],
        "scopes": [
          "records/one"
        ]
      },
      "expected": {
        "kind": "refuse",
        "status": "nonzero",
        "reason": "unbound-signer",
        "forbiddenEffects": [
          "authority-from-carrier",
          "cross-place-write",
          "secret-disclosure",
          "signature-acquisition",
          "act-admission",
          "accepted-content"
        ],
        "publicCatalogRecord": true
      }
    },
    {
      "id": "mismatch",
      "operation": "signing-request",
      "input": {
        "keyId": "actor",
        "lotKeyId": "other-actor",
        "coverage": [
          "records/**"
        ],
        "scopes": [
          "records/one"
        ]
      },
      "expected": {
        "kind": "refuse",
        "status": "nonzero",
        "reason": "signer-mismatch",
        "forbiddenEffects": [
          "authority-from-carrier",
          "cross-place-write",
          "secret-disclosure",
          "signature-acquisition",
          "act-admission",
          "accepted-content"
        ],
        "publicCatalogRecord": true
      }
    }
  ]
}
