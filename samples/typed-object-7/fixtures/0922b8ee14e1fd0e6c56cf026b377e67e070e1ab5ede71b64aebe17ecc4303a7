export function eq(L, a, b) {
    return L.leq(a, b) && L.leq(b, a);
}
export function relate(L, a, b) {
    const ab = L.leq(a, b);
    const ba = L.leq(b, a);
    if (ab && ba)
        return 'equal';
    if (ab)
        return 'narrower';
    if (ba)
        return 'wider';
    return 'incomparable';
}
