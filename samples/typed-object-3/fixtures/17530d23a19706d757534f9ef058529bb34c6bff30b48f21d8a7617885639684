import {intervalForm, alphabetOfForm} from './c83b5bde9c38bc8c4f3e63014c1a147a43d5f0c70b844f9ba05f686ed918d4bf';

// This sample world grants origins and local openings only from admitted records.
// Signing authority and observation origin are separate inputs.
export function context({digest, records, admit}) {
  const granted = (family, id, by, scope) => records.filter(row =>
    row.scope === `${family}/${id}` && row.value === id && row.by === by && admit(row)
      && (row.condition ?? '').split('|').includes(scope)).length === 1;
  return {
    resolve(cell) {
      const form=[intervalForm,alphabetOfForm].find(one=>one.id===cell.fields.form);
      if(!form)throw Error('REFUSE·codec sample has no selected form');
      return {digest,form,params:JSON.parse(cell.fields.params)};
    },
    origin: (id, by, scope) => granted('evidence/origin', id, by, scope),
    witness: (id, by, scope) => granted('evidence/witness', id, by, scope),
  };
}
