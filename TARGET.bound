bound-lock/1 about="{\n  \"name\": \"@lapxo/bound\",\n  \"version\": \"0.1.5\",\n  \"type\": \"module\",\n  \"description\": \"Read the bounds you already wrote, fold them, and name the contradictions.\",\n  \"main\": \"dist/cli/verb.js\",\n  \"types\": \"dist/cli/verb.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/cli/verb.d.ts\",\n      \"default\": \"./dist/cli/verb.js\"\n    },\n    \"./package.json\": \"./package.json\"\n  },\n  \"scripts\": {\n    \"test\": \"node --import ./test/setup.ts --test --test-concurrency=2 test/*.test.ts\",\n    \"clean\": \"rm -rf dist .tsbuildinfo* tsconfig.tsbuildinfo\",\n    \"build\": \"node tools/build.mjs\",\n    \"prepack\": \"npm run build\"\n  },\n  \"files\": [\n    \"CONTRIBUTING.md\",\n    \"LICENSE\",\n    \"README.md\",\n    \"TARGET.bound\",\n    \"dist/**/*\",\n    \"docs/contracts/*.md\",\n    \"docs/contracts/*.publication.json\",\n    \"docs/contracts/archive.md\",\n    \"docs/contracts/cli.md\",\n    \"docs/contracts/documents.md\",\n    \"docs/contracts/evidence-view.md\",\n    \"docs/contracts/publication.inventory.json\",\n    \"docs/contracts/typed-object.md\",\n    \"docs/contracts/view-walk.md\",\n    \"docs/contracts/views.md\",\n    \"docs/readme-assets/atlas.svg\",\n    \"docs/usage.md\",\n    \"package.json\",\n    \"receipts.bound\",\n    \"samples/artifacts-changed/TARGET.bound\",\n    \"samples/artifacts-changed/fixtures/0573c65d6a55bc4c20cd0e2e537e9ae6d275825b0d6e09bf20828c193b0d0a87\",\n    \"samples/artifacts-changed/fixtures/074b6ed9317c6decee6b493373f01d3fcd4401c72604ee5a1d20bee0c4a5bb49\",\n    \"samples/artifacts-changed/fixtures/0922b8ee14e1fd0e6c56cf026b377e67e070e1ab5ede71b64aebe17ecc4303a7\",\n    \"samples/artifacts-changed/fixtures/0a5e879b024f10d8b895c9e574caa2141a59dac07eed8a384fb6e903ff069828\",\n    \"samples/artifacts-changed/fixtures/0cc476498db21b2aab91e90cc0172bb34373cbe2876a21a21efdc8ba088112b0\",\n    \"samples/artifacts-changed/fixtures/103d41dd0dc8fc9386fa