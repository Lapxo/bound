bound-lock/1 about="Bound is the application of that algebra: signed bounds, folded by one meet, refused when they fork." at=policy:bound/010 by=owner epoch=1 form=alphabet measure=text role=writes scope=prose/en/paper sig="ed25519:era1:/jzLHBxzq1CwOI6RpUlR6D3a+TP6ZEEqrG3oBkesArmAI9mT5Ye7Ru7ooT048k5Y/IpZPNcaXN/P/uJz75VlCw==" value=present
