bound-lock/1 about="name: release\non:\n  workflow_run:\n    workflows: [tag]\n    types: [completed]\n  push:\n    tags: ['v*']\njobs:\n  release:\n    if: github.event_name == 'push' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_branch == 'main')\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    outputs:\n      tag: ${{ steps.version.outputs.tag }}\n      asset: ${{ steps.archive.outputs.asset }}\n      sha256: ${{ steps.archive.outputs.sha256 }}\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha || github.sha }}\n          fetch-depth: 0\n      - id: version\n        env:\n          EVENT_NAME: ${{ github.event_name }}\n          REF_NAME: ${{ github.ref_name }}\n        run: |\n          version=\"v$(node -p \"require('./package.json').version\")\"\n          if [ \"$EVENT_NAME\" = push ]; then\n            test \"$REF_NAME\" = \"$version\"\n          fi\n          git rev-parse --verify \"refs/tags/$version\"\n          echo \"tag=$version\" >> \"$GITHUB_OUTPUT\"\n          git checkout --detach \"$version\"\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm ci\n      - run: npm run build\n      - run: npm test\n      - run: node dist/cli/verb.js fold --check\n      - id: archive\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          version=\"${{ steps.version.outputs.tag }}\"\n          asset=\"$(npm pack --ignore-scripts --silent)\"\n          echo \"asset=$asset\" >> \"$GITHUB_OUTPUT\"\n          expected=\"$(sha256sum \"$asset\" | cut -d ' ' -f 1)\"\n          echo \"sha256=$expected\" >> \"$GITHUB_OUTPUT\"\n          if ! gh release view \"$version\" >/dev/null 2>&1; then\n            gh release create \"$version\" \"$asset\" --title \"$version\" --notes \"$(git log -1 --format=%B)\"\n          fi\n          download_dir=\"$(mktemp -d)\"\n          gh release download \"$version\" --pattern \"$asset\" --dir \"$download_dir\"\n          actual=\"$(sha256sum \"$download_dir/$asset\" | cut -d ' ' -f 1)\"\n          test \"$expected\" = \"$actual\"\n  publish:\n    needs: release\n    environment: release\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      id-token: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ needs.release.outputs.tag }}\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm install --global npm@'12.1.0'\n      - env:\n          GH_TOKEN: ${{ github.token }}\n          TAG: ${{ needs.release.outputs.tag }}\n          ASSET: ${{ needs.release.outputs.asset }}\n          EXPECTED: ${{ needs.release.outputs.sha256 }}\n        run: |\n          mkdir candidate\n          gh release download \"$TAG\" --pattern \"$ASSET\" --dir candidate\n          actual=\"$(sha256sum \"candidate/$ASSET\" | cut -d ' ' -f 1)\"\n          test \"$EXPECTED\" = \"$actual\"\n          npm stage publish \"./candidate/$ASSET\" --access public --ignore-scripts\n" at=policy:bound/011-port-release by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/release shape=.github/workflows/release.yml value=lock
bound-lock/1 about="name: tag\non:\n  workflow_run:\n    workflows: [test]\n    types: [completed]\njobs:\n  tag:\n    if: github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha }}\n          fetch-depth: 0\n      - run: |\n          version=\"v$(node -p \"require('./package.json').version\")\"\n          git tag --list \"$version\" | grep -q . && exit 0\n          git tag \"$version\" && git push origin \"$version\"\n" at=policy:bound/pipeline by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/tag shape=.github/workflows/tag.yml value=lock
bound-lock/1 about="name: test\non:\n  push:\n    branches: [main]\n  pull_request:\njobs:\n  test:\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n      - run: npm ci\n      - run: npm run build\n      - run: npm test\n      - name: Verify native closure and receipt reuse\n        run: |\n          node dist/cli/verb.js fold --check > \"$RUNNER_TEMP/bound-check.log\" 2>&1 || { cat \"$RUNNER_TEMP/bound-check.log\"; exit 1; }\n          cat \"$RUNNER_TEMP/bound-check.log\"\n          grep -Eq '^PASS +closed' \"$RUNNER_TEMP/bound-check.log\"\n          grep -Eq '^RECEIPTS [1-9][0-9]* read · 0 opened' \"$RUNNER_TEMP/bound-check.log\"\n      - run: npm pack --silent\n" at=policy:bound/pipeline by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/test shape=.github/workflows/test.yml value=lock
