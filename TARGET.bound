bound-lock/1 about="name: release\non:\n  workflow_run:\n    workflows: [tag]\n    types: [completed]\n  workflow_dispatch:\njobs:\n  stage:\n    if: github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.head_branch == 'main')\n    concurrency: release-delivery\n    environment: release\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n      id-token: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha || github.sha }}\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm ci --ignore-scripts\n      - run: npm run build\n      - run: npm install --global npm@'12.1.0' --ignore-scripts\n      - name: Prepare release\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          TAG=\"v$(node -p \"require('./package.json').version\")\"\n          printf 'TAG=%s\\n' \"$TAG\" >> \"$GITHUB_ENV\"\n          git fetch origin \"refs/tags/$TAG:refs/tags/$TAG\"\n          gh api --paginate \"repos/$GITHUB_REPOSITORY/releases\" --jq '.[].tag_name' > \"$RUNNER_TEMP/release-tags\"\n          if grep -Fxq \"$TAG\" \"$RUNNER_TEMP/release-tags\"; then\n            printf 'RELEASE %s · exists\\n' \"$TAG\"\n          else\n            gh release create \"$TAG\" --verify-tag --draft --title \"$TAG\" --generate-notes\n            printf 'RELEASE %s · draft created · awaiting signed assets\\n' \"$TAG\"\n          fi\n      - name: Read owner approval\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          mkdir .release\n          gh release download \"$TAG\" --pattern approval-signed --dir .release\n          node dist/cli/verb.js fold --as release .release/approval-signed > .release/verdict\n          cat .release/verdict\n      - name: Stage the approved release archive\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          read -r status digest archive source extra < .release/verdict\n          test \"$status\" = READY\n          test -z \"$extra\"\n          gh release download \"$TAG\" --pattern \"$archive\" --dir .release\n          printf '%s  %s\\n' \"${digest#sha256:}\" \".release/$archive\" | sha256sum -c -\n          expected=\"$(node -p \"require('./package.json').name+'@'+require('./package.json').version\")\"\n          actual=\"$(tar -xOf \".release/$archive\" package/package.json | node -p \"const p=JSON.parse(require('fs').readFileSync(0,'utf8'));p.name+'@'+p.version\")\"\n          test \"$actual\" = \"$expected\"\n          printf 'SOURCE release/%s/%s · %s · declared %s\\n' \"$TAG\" \"$archive\" \"$digest\" \"$source\"\n          gh release edit \"$TAG\" --draft=false\n          printf 'RELEASE %s · published · %s\\n' \"$TAG\" \"$digest\"\n          npm stage publish \".release/$archive\" --access public --ignore-scripts\n          printf 'STAGED %s · %s · owner approval pending\\n' \"$actual\" \"$digest\"\n" at=witness:bound-017-automatic-approved-delivery by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/release shape=.github/workflows/release.yml value=lock
bound-lock/1 about="name: tag\non:\n  workflow_run:\n    workflows: [test]\n    types: [completed]\njobs:\n  tag:\n    if: github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ${{ github.event.workflow_run.head_sha }}\n          fetch-depth: 0\n      - run: |\n          version=\"v$(node -p \"require('./package.json').version\")\"\n          git tag --list \"$version\" | grep -q . && exit 0\n          git tag \"$version\" && git push origin \"$version\"\n" at=policy:bound/pipeline by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/tag shape=.github/workflows/tag.yml value=lock
bound-lock/1 about="name: test\non:\n  push:\n    branches: [main]\n  pull_request:\npermissions:\n  contents: read\njobs:\n  test:\n    strategy:\n      fail-fast: false\n      matrix:\n        node: [22, 24]\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n      - run: npm ci --ignore-scripts\n      - run: npm audit signatures\n      - run: npm run build\n      - name: Run tests\n        run: |\n          set -euo pipefail\n          node --import ./test/setup.ts --test --test-concurrency=1 test/*.test.ts 2>&1 | tee \"$RUNNER_TEMP/bound-tests.log\"\n      - name: Form exact archive once\n        if: matrix.node == 24\n        run: |\n          mkdir \"$RUNNER_TEMP/exact\"\n          npm run compact-archive -- --from-place . \"$RUNNER_TEMP/exact/lapxo-bound-0.2.6.tgz\"\n      - uses: actions/upload-artifact@v4\n        if: matrix.node == 24\n        with:\n          name: bound-exact-archive\n          path: ${{ runner.temp }}/exact/lapxo-bound-0.2.6.tgz\n          if-no-files-found: error\n      - name: Preserve test logs\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: bound-node-${{ matrix.node }}\n          path: ${{ runner.temp }}/bound-tests.log\n          if-no-files-found: ignore\n  exact_archive:\n    needs: test\n    runs-on: ubuntu-24.04\n    outputs:\n      archive_digest: ${{ steps.identity.outputs.archive_digest }}\n    steps:\n      - uses: actions/download-artifact@v4\n        with:\n          name: bound-exact-archive\n          path: .exact-input\n      - id: identity\n        run: printf 'archive_digest=sha256:%s\\n' \"$(sha256sum .exact-input/lapxo-bound-0.2.6.tgz | cut -d ' ' -f1)\" >> \"$GITHUB_OUTPUT\"\n  portability-ci:\n    needs: exact_archive\n    permissions:\n      contents: read\n      actions: read\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-24.04, macos-14]\n        node: [22, 24]\n    runs-on: ${{ matrix.os }}\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n      - run: npm ci --ignore-scripts\n      - run: npm audit signatures\n      - uses: actions/download-artifact@v4\n        with:\n          name: bound-exact-archive\n          path: .portability-input\n      - name: Check installed archive and native attestation\n        run: node --experimental-strip-types --test test/portability-installed.test.ts\n        env:\n          BOUND_PORTABILITY_ARCHIVE: .portability-input/lapxo-bound-0.2.6.tgz\n          BOUND_PORTABILITY_DIGEST: ${{ needs.exact_archive.outputs.archive_digest }}\n          BOUND_PORTABILITY_CAPTURE: ${{ runner.temp }}/portability-evidence.json\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: portability-${{ matrix.os }}-node-${{ matrix.node }}\n          path: ${{ runner.temp }}/portability-evidence.json\n          if-no-files-found: error\n" at=witness:release-archive-version by=target form=alphabet measure=text role=writes scope=prose/en/files/workflow/test shape=.github/workflows/test.yml value=lock
bound-lock/1 about="npx @lapxo/bound@0.2.0 fold --as help\nnpx @lapxo/bound@0.2.0 fold" at=policy:bound/020-candidate-metadata by=target form=alphabet measure=text role=writes scope=prose/en/commands value=lock
bound-lock/1 about="obligations is the meet. topos is the line. Worlds outside bound read a calendar, a package, a page. Bound reads lines, folds them, lands what was signed, and signs." at=policy:bound/010 by=target form=alphabet measure=text role=writes scope=prose/en/rests/on value=present
