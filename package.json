{
  "name": "@lapxo/bound",
  "version": "0.2.0",
  "type": "module",
  "description": "Read the bounds you already wrote, fold them, and name the contradictions.",
  "main": "dist/cli/verb.js",
  "types": "dist/cli/verb.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/verb.d.ts",
      "default": "./dist/cli/verb.js"
    },
    "./package.json": "./package.json",
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm/adapter.d.ts",
      "default": "./dist/wasm/adapter.js"
    },
    "./reference": {
      "types": "./dist/host/reference-authenticated.d.ts",
      "default": "./dist/host/reference-authenticated.js"
    }
  },
  "scripts": {
    "test": "node --import ./test/setup.ts --test --test-concurrency=2 test/*.test.ts",
    "clean": "rm -rf dist .tsbuildinfo* tsconfig.tsbuildinfo",
    "build": "node tools/build.mjs",
    "prepack": "npm run build"
  },
