{
  "name": "@lapxo/bound",
  "version": "0.1.5",
  "type": "module",
  "description": "Read the bounds you already wrote, fold them, and name the contradictions.",
  "main": "dist/cli/verb.js",
  "types": "dist/cli/verb.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/verb.d.ts",
      "default": "./dist/cli/verb.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --import ./test/setup.ts --test --test-concurrency=2 test/*.test.ts",
    "clean": "rm -rf dist .tsbuildinfo* tsconfig.tsbuildinfo",
    "build": "node tools/build.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "dist/**/*",
    "TARGET.bound",
    "receipts.bound",
    "docs/usage.md",
    "docs/readme-assets/atlas.svg",
    "samples/typed/*.json",
    "tools/samples/*.mjs",
    "samples/walk/*.json",
    "vectors/native-walk.json",
    "docs/contracts/*.md",
    "docs/contracts/*.publication.json",
    "docs/contracts/publication.inventory.json",
    "samples/yes/typed-object.json",
    "samples/no/typed-object.json",
    "samples/yes/attest-evidence.json",
    "samples/no/attest-evidence.json",
    "vectors/typed-object.json",
    "vectors/attest-evidence.json",
    "samples/yes/signing-port.json",
    "samples/no/signing-port.json",
    "vectors/signing-port.json",
    "samples/yes/native-views.json",
    "samples/no/native-views.json",
    "vectors/native-views.json",
    "samples/yes/query-views.json",
    "samples/no/query-views.json",
    "vectors/query-views.json",
    "samples/yes/prose-views.json",
    "samples/no/prose-views.json",
    "vectors/prose-views.json",
    "samples/yes/program-views.json",
    "samples/no/program-views.json",
    "vectors/program-views.json",
    "samples/yes/historical-document-views.json",
    "samples/no/historical-document-views.json",
    "vectors/historical-document-views.json",
    "samples/yes/historical-build.json",
    "samples/no/historical-build.json",
    "vectors/historical-build.json",
    "samples/yes/historical-presentation.json",
    "samples/no/historical-presentation.json",
    "vectors/historical-presentation.json",
    "samples/yes/walk.json",
    "samples/no/walk.json",
    "vectors/walk-publication.json",
    "samples/yes/archive-conformance.json",
    "vectors/archive-conformance.json",
    "samples/no/archive-conformance.json"
  ],
  "author": "Lapxo",
  "license": "MIT",
  "dependencies": {
    "@lapxo/obligations": "0.3.5",
    "@lapxo/topos": "^0.1.11",
    "acorn": "8.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "bound": "./dist/cli/verb.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lapxo/bound.git"
  },
  "homepage": "https://github.com/Lapxo/bound#readme",
  "bugs": {
    "url": "https://github.com/Lapxo/bound/issues"
  },
  "keywords": [
    "cli",
    "content-addressed",
    "provenance",
    "receipts",
    "constraints",
    "reproducible"
  ]
}
