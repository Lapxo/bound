    "./closure/native": {
      "types": "./dist/host/native/module-delivery.d.ts",
      "default": "./dist/host/native/module-delivery.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    }
  },
